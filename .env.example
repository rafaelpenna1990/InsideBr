# Copie este arquivo para .env e preencha com seus valores reais
# .env nunca deve ser commitado no git

# String de conexão do Postgres (local ou do Render)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/insidebr

# Porta do servidor Express
PORT=3000

# URL base dos dados abertos da CVM (não deve precisar mudar)
CVM_VLMO_BASE_URL=https://dados.cvm.gov.br/dados/CIA_ABERTA/DOC/VLMO/DADOS

# Token gratuito da brapi.dev (para mapear empresas → ticker da B3)
# Pegue o seu em https://brapi.dev/dashboard
BRAPI_TOKEN=
